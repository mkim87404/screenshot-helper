<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia desktop app: views, view-models, tray, toast and session orchestration. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The exe's file name and its file description (what the taskbar, Task Manager and Windows' tray settings show) both read
         "Screenshot Helper"; code namespaces and the data folders (%APPDATA%\ScreenshotHelper) keep the unspaced identifier. -->
    <AssemblyName>Screenshot Helper</AssemblyName>
    <AssemblyTitle>Screenshot Helper</AssemblyTitle>
    <RootNamespace>ScreenshotHelper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenshotHelper.Core\ScreenshotHelper.Core.csproj" />
    <ProjectReference Include="..\ScreenshotHelper.Platform.Windows\ScreenshotHelper.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScreenshotHelper.App.Tests" />
  </ItemGroup>
</Project>
