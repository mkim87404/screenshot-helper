<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScreenshotHelper.App.ViewModels"
             xmlns:v="using:ScreenshotHelper.App.Views"
             xmlns:rn="using:ScreenshotHelper.Core.Renumber"
             x:Class="ScreenshotHelper.App.Views.RenumberView"
             x:DataType="vm:RenumberViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,16,*">
    <StackPanel Grid.ColumnSpan="3" Spacing="4">
      <TextBlock Classes="h1" Text="Renumber" />
      <TextBlock Classes="muted" Text="Fix numbering in bulk. Only the numbers change — timestamps, captions and anything else in the names are kept exactly." />
    </StackPanel>

    <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12">
      <TextBox Text="{Binding Folder}" IsReadOnly="True" PlaceholderText="No folder chosen" AutomationProperties.Name="Folder to renumber" />
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Command="{Binding BrowseCommand}" />
      <Button Grid.Column="2" Margin="8,0,0,0" Content="Reload" Command="{Binding RefreshCommand}" />
    </Grid>

    <!-- Files -->
    <Border Grid.Row="2" Classes="card" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
          <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="Select all" Command="{Binding SelectAllCommand}" CommandParameter="{x:True}" />
          <Button Grid.Column="2" Classes="link" Content="Clear" Command="{Binding SelectAllCommand}" CommandParameter="{x:False}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Height="170" Margin="0,8,0,0" CornerRadius="6" Background="{DynamicResource PageBackground}"
                IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                 AutomationProperties.Name="Preview of the focused screenshot" />
        </Border>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RenumberFileViewModel">
                <StackPanel>
                  <Button Classes="link" Margin="0,8,0,0" IsVisible="{Binding StartsGroup}" Content="{Binding GroupLabel}" FontWeight="SemiBold"
                          ToolTip.Tip="Select or clear this whole group"
                          Command="{Binding $parent[UserControl].((vm:RenumberViewModel)DataContext).SelectGroupCommand}" CommandParameter="{Binding}" />
                  <Grid ColumnDefinitions="Auto,*" Margin="16,0,0,0">
                    <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding FileName}" />
                    <Button Grid.Column="1" Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip.Tip="{Binding FileName}" AutomationProperties.Name="{Binding FileName, StringFormat='Preview {0}'}"
                            Command="{Binding $parent[UserControl].((vm:RenumberViewModel)DataContext).ShowPreviewCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Operation + preview -->
    <Border Grid.Row="2" Grid.Column="2" Classes="card" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" HorizontalAlignment="Stretch" AutomationProperties.Name="Renumber operation" />
          <TextBlock Classes="muted" Text="{Binding OperationHelp}" />

          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsShift}">
            <StackPanel Spacing="2"><TextBlock Text="Main +/−" /><NumericUpDown Value="{Binding MainDelta}" Increment="1" FormatString="0" Width="130" AutomationProperties.Name="Main number change" /></StackPanel>
            <StackPanel Spacing="2"><TextBlock Text="Sub +/−" /><NumericUpDown Value="{Binding SubDelta}" Increment="1" FormatString="0" Width="130" AutomationProperties.Name="Sub number change" /></StackPanel>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding IsCloseGaps}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox Content="Renumber groups from" IsChecked="{Binding RenumberGroups}" />
              <NumericUpDown Value="{Binding StartMain}" Minimum="0" Increment="1" FormatString="0" Width="130" IsEnabled="{Binding RenumberGroups}" AutomationProperties.Name="First group number" />
            </StackPanel>
            <CheckBox Content="Renumber sub numbers from 1" IsChecked="{Binding CompactSubs}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsMoveToGroup}">
            <StackPanel Spacing="2"><TextBlock Text="Group" /><NumericUpDown Value="{Binding TargetMain}" Minimum="0" Increment="1" FormatString="0" Width="130" AutomationProperties.Name="Target group" /></StackPanel>
            <StackPanel Spacing="2"><TextBlock Text="Starting sub" /><NumericUpDown Value="{Binding StartSub}" Minimum="0" Increment="1" FormatString="0" Width="130" AutomationProperties.Name="Starting sub number" /></StackPanel>
          </StackPanel>

          <TextBlock Classes="h2" Margin="0,8,0,0" Text="Preview" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
          <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding MessageIsError}" />
          <TextBlock Foreground="{DynamicResource SuccessText}" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding !MessageIsError}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" />
            <Button Content="Undo last renumber" Command="{Binding UndoLastCommand}" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="rn:PlanRow">
                <StackPanel Margin="0,3">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Source}" />
                    <Run Text="  →  " Foreground="{DynamicResource MutedText}" />
                    <Run Text="{Binding Target}" FontWeight="SemiBold" />
                  </TextBlock>
                  <TextBlock FontSize="12" Text="{Binding Message}" TextWrapping="Wrap"
                             Classes.warning="{Binding Status, Converter={x:Static v:PlanStatusConverter.IsWarning}}"
                             Classes.error="{Binding Status, Converter={x:Static v:PlanStatusConverter.IsConflict}}"
                             IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
