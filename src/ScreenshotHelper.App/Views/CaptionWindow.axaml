<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenshotHelper.App.ViewModels"
        x:Class="ScreenshotHelper.App.Views.CaptionWindow"
        x:DataType="vm:CaptionViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource CardBackground}">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Classes="h2" Text="{Binding Title}" />
    <!-- MaxLength stops input at the budget (typing and paste); the code-behind filters characters Windows forbids in file names. -->
    <TextBox x:Name="CaptionBox" Text="{Binding Text}" MaxLength="{Binding Budget}" IsEnabled="{Binding CanType}"
             PlaceholderText="e.g. login page"
             AutomationProperties.Name="Caption" AutomationProperties.HelpText="{Binding RemainingText}" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted" Text="{Binding InvalidCharactersHint}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding RemainingText}" />
    </Grid>
    <TextBlock Classes="warning" Text="Characters that can't be used in file names were left out." IsVisible="{Binding RemovedInvalid}" />
    <TextBlock Classes="muted" Text="Leave empty and press Enter to remove the caption." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button Classes="primary" Content="Save caption" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
